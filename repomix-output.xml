import React, { useState } from 'react';
import { collection, addDoc } from 'firebase/firestore';
import { db } from '../firebase';

const AddEmailForm = ({ isOpen, onClose, onEmailAdded }) => {
  const [email, setEmail] = useState('');
  const [name, setName] = useState('');
  const [password, setPassword] = useState('');
  const [error, setError] = useState('');
  const [isSubmitting, setIsSubmitting] = useState(false);

  // Наша збережена логіка обробки форми
  const handleSubmit = async (e) => {
    e.preventDefault();
    setError('');

    // Видаляємо пробіли, якщо користувач скопіював пароль з ними
    const cleanPassword = password.replace(/\s/g, '');

    // Валідація: Пароль додатка Google завжди має 16 символів
    if (cleanPassword.length !== 16) {
      setError('Пароль додатка має містити рівно 16 символів. Перевір, чи правильно ти його скопіював з налаштувань Google.');
      return;
    }

    setIsSubmitting(true);

    try {
      // ТУТ НАША ЛОГІКА ЗБЕРЕЖЕННЯ (або виклик функції з пропсів)
      // await addDoc(collection(db, 'emails'), {
      //   email,
      //   name,
      //   password: cleanPassword,
      //   createdAt: new Date(),
      //   status: 'active'
      // });

      // Якщо ти передаєш функцію збереження зверху:
      if (onEmailAdded) {
        await onEmailAdded({ email, name, password: cleanPassword });
      }

      // Очищаємо стейти після успішного додавання
      setEmail('');
      setName('');
      setPassword('');
      onClose();
    } catch (err) {
      console.error("Помилка додавання пошти:", err);
      setError('Не вдалося підключити пошту. Перевір дані та спробуй ще раз.');
    } finally {
      setIsSubmitting(false);
    }
  };

  if (!isOpen) return null;

  return (
    <div style={styles.overlay}>
      <div style={styles.modal}>
        <div style={styles.header}>
          <h3 style={styles.title}>Підключення Gmail акаунта</h3>
          <button style={styles.closeBtn} onClick={onClose} aria-label="Закрити">
            &times;
          </button>
        </div>

        {error && (
          <div style={styles.errorBox}>
            {error}
          </div>
        )}

        <form onSubmit={handleSubmit} style={styles.form}>
          <div style={styles.inputGroup}>
            <label style={styles.label}>Відображуване ім'я (Відправник)</label>
            <input 
              type="text" 
              required 
              value={name} 
              onChange={(e) => setName(e.target.value)} 
              placeholder="Кафедра Інформаційних Систем" 
              style={styles.input} 
            />
          </div>

          <div style={styles.inputGroup}>
            <label style={styles.label}>Електронна пошта (Gmail)</label>
            <input 
              type="email" 
              required 
              value={email} 
              onChange={(e) => setEmail(e.target.value)} 
              placeholder="example@gmail.com" 
              style={styles.input} 
            />
          </div>

          <div style={styles.inputGroup}>
            <label style={styles.label}>Пароль додатка (App Password)</label>
            <input 
              type="password" 
              required 
              value={password} 
              onChange={(e) => setPassword(e.target.value)} 
              placeholder="•••• •••• •••• ••••" 
              style={styles.input} 
            />
            <span style={styles.hintText}>
              💡 <strong>Увага:</strong> Використовуйте не ваш основний пароль від пошти, а спеціальний 16-значний "Пароль додатка" (App Password), згенерований у налаштуваннях безпеки вашого Google акаунта.
            </span>
          </div>

          <div style={styles.footer}>
            <button type="button" onClick={onClose} style={styles.cancelBtn} disabled={isSubmitting}>
              Скасувати
            </button>
            <button type="submit" style={styles.submitBtn} disabled={isSubmitting}>
              {isSubmitting ? 'Підключення...' : 'Зберегти та підключити'}
            </button>
          </div>
        </form>
      </div>
    </div>
  );
};

// Акуратні стилі для UniSync
const styles = {
  overlay: {
    position: 'fixed', top: 0, left: 0, right: 0, bottom: 0,
